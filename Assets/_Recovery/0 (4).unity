  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "If you\u2019re reading this, I\u2019ve already gone. Don\u2019t worry
    - this isn\u2019t a cry for help (probably).\n\nI\u2019ve gone out there\u2026
    into the stars. Someone had to. The ones who left before us - they\u2019re still
    out there somewhere, and if I can find them, maybe I can figure out what really
    happened to the universe before it\u2019s too late.\n\nThere\u2019s another ship
    by the dock. Take it. It\u2019s mostly held together.\n\nOh - and take the gun.
    You know, just in case the universe bites back.\n\n- Bob"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
