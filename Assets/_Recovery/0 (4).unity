--- !u!114 &1399634313
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1399634310}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52fe17ae008f84e0d985ae47d385e7f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  dialogueText: {fileID: 440427482}
  nameText: {fileID: 1507290361}
  dialoguePanel: {fileID: 448377634}
  npcDialogues:
  - Hey! Look at all these fish!
  - What do you mean?
  - ...
  - hm.... can you sail?
  - Why do you need it
  - I've never been to the island before, it looks so.. spooky
  - Bob... bob, hm... Oh yeah BOB! The squishy hairy one, he was a bit odd
  - Okay sure you can borrow my boat, just watch out for the sharks
  - I don't know, maybe
  playerDialogues:
  - Yeah... that is a lot of fish! I don't mean to be rude but, how do you catch
    them?
  - Well i just thought since you have no... You know what never mind.
  - I really just wanted to see if i could maybe borrow your boat for a bit
  - I honestly dont know.
  - I wanted to go to the lighthouse
  - Me neither, but i heard that Bob lives there
  - Yeah i guess, i dont know why, but ive been thinking about him lately and need
    to ask him some questions
  - Are there sharks here?
  npcName: Leela
  player: {fileID: 426326407}
  TalkingClip: {fileID: 8300000, guid: 2aba1fe8d503346deba5097ffe81c362, type: 3}
  inputSource: {fileID: 1035694200}
